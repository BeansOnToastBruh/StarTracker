{
  "name": "startracker",
  "productName": "StarTracker",
  "version": "1.0.19",
  "description": "StarTracker: Star Citizen session stats from Game.log, system tray companion",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prebuild:icon": "node scripts/generate-icon.js",
    "pack": "npm run prebuild:icon && electron-builder --win --dir --publish never",
    "dist": "npm run dist:win",
    "dist:win": "npm run prebuild:icon && electron-builder --win --publish never",
    "dist:linux": "npm run prebuild:icon && electron-builder --linux --publish never",
    "build:win": "npm run dist:win",
    "build:linux": "npm run dist:linux",
    "verify": "node scripts/verify-repo-hygiene.js",
    "build:catalog": "node scripts/build-catalog-seed.js"
  },
  "build": {
    "appId": "com.startracker.app",
    "productName": "StarTracker",
    "executableName": "StarTracker",
    "copyright": "Copyright © StarTracker",
    "afterPack": "./scripts/after-pack.js",
    "afterAllArtifactBuild": "./scripts/after-all-artifact-build.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "data/**/*",
      "build-meta.json",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "data/catalog/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "StarTracker",
      "artifactName": "StarTracker-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StarTracker",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "StarTracker-${version}-portable.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "StarTracker",
      "artifactName": "StarTracker-${version}-${arch}.${ext}",
      "synopsis": "Star Citizen session stats from Game.log",
      "description": "Tray companion that tails Game.log for session debrief stats."
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  }
}
